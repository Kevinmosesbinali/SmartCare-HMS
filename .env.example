# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL / Cloud SQL Runtime Variables (Object Method)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="smartcare_hms"
SQL_USER="smartcare_app"
SQL_PASSWORD="change_me"
SQL_SSL="false"

# PostgreSQL Admin Variables (for Drizzle Kit schema migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="change_me"

# Session Security
SESSION_SECRET="replace_with_a_long_random_secret_in_production"
NODE_ENV="development"
